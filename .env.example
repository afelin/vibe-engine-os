# Copy to .env for local runs (never commit .env)

# Lovable / TabDab React app — merges allowed paths from src/policy/profiles/tabdab.json
# VIBE_PROJECT_PROFILE=tabdab

# Depth dial: 0 explain, 1 plan, 2 safe files, 3 tests (default), 4 deploy, 5 protected
# VIBE_DEPTH=3

# Daily runs at depth ≥ 3: subgraph vitest (changed files only). Use full for CI parity.
# VIBE_TEST_MODE=subgraph
